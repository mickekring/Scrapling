# Copy to `.env` and fill in. NEVER commit the real .env (it holds secrets).

# --- Auth ---------------------------------------------------------------
# Clients send this as the `X-API-Key` header. If blank, the API is OPEN.
# Generate one with:  openssl rand -hex 32
API_KEY=

# --- Apify proxy (datacenter / "ordinary") ------------------------------
# Find the password on the Proxy page of the Apify Console. Blank = no proxy.
APIFY_PROXY_PASSWORD=
APIFY_PROXY_HOST=proxy.apify.com
APIFY_PROXY_PORT=8000
APIFY_PROXY_USERNAME=auto

# --- Request defaults (overridable per request) -------------------------
DEFAULT_FORMAT=markdown      # html | text | markdown
DEFAULT_ENGINE=auto          # auto | http | dynamic | stealth
DEFAULT_PROXY=off            # off | on | auto
MAIN_CONTENT_ONLY=true

# --- Tuning -------------------------------------------------------------
HTTP_TIMEOUT=30
MAX_CONCURRENT_BROWSERS=2
REQUEST_MAX_SECONDS=120
